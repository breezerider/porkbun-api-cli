graft docs
graft src
graft tests
prune ci

include .readthedocs.yml
include pyproject.toml
include tox.ini

include AUTHORS.rst
include CHANGELOG.rst
include CONTRIBUTING.rst
include LICENSE
include README.rst

global-exclude *.py[cod] __pycache__/* *.so *.dylib

# Opencode project meta — not part of the sdist; opencode agent land, not user land.
prune .agents
prune docs/ristretto
prune .ristretto
exclude AGENTS.md
exclude .ristretto.json
exclude uv.lock
